# GridGuard local settings.
# Copy this file to `.env` (git-ignored) and fill in your values:  cp .env.example .env
# Read by backend/shared/config.py. In AWS, the SAM template sets these instead.
#
# NEVER put AWS access keys here. Use the ~/.aws profile instead.

# --- AWS ---
AWS_PROFILE=gridguard
AWS_REGION=us-east-1

# --- Bedrock (P2) ---
# Inference profile ID, e.g. us.anthropic.claude-sonnet-4-5-20250929-v1:0 (P2 picks the final one)
BEDROCK_MODEL_ID=
# Filled in after P2-10 creates the guardrail
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# --- Storage (names come from the deployed SAM stack, P3-04) ---
RUNS_TABLE=gridguard-runs
DECISIONS_TABLE=gridguard-decisions
COUNTERS_TABLE=gridguard-counters
# Leave FORECAST_BUCKET empty to read scenarios/ and forecasts/ from the repo (local dev)
FORECAST_BUCKET=
FORECAST_PREFIX=forecasts/
SCENARIO_PREFIX=scenarios/

# --- Secrets ---
# Name of the SSM parameter that holds the EIA key (not the key itself)
EIA_API_KEY_PARAM=/gridguard/eia-api-key
# Optional, local only (ML scripts on your laptop). Leave empty to read from SSM.
EIA_API_KEY=

# --- Limits ---
DAILY_RUN_CAP=100
AGENT_MAX_SIMULATE_CALLS=5
AGENT_MAX_TOOL_CALLS=12
LOG_LEVEL=INFO
