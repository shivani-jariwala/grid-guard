# --- ML: raw data and trained models are large and can be regenerated ---
ml/data/
ml/artifacts/

# --- AWS SAM build output ---
.aws-sam/

# --- Frontend ---
node_modules/
frontend/dist/
*.local

# --- Kiro: per-user settings (MCP config can hold tokens) ---
.kiro/settings/

# --- OS / editors / logs ---
.DS_Store
.idea/
*.log
